{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "disabled_hooks": [],
  "disabled_agents": [],
  "disabled_skills": [],
  "disabled_mcps": [],

  // ── Agents: Z.AI primary → OpenCode Go fallback ──────────────────────
  "agents": {
    "sisyphus": {
      "model": "zai/glm-4.7",
      "fallback_models": ["opencode-go/deepseek-v4-pro", "opencode-go/kimi-k2.5"]
    },
    "oracle": {
      "model": "zai/glm-5.1",
      "thinking": { "type": "enabled" },
      "fallback_models": ["opencode-go/glm-5.1", "opencode-go/deepseek-v4-pro"]
    },
    "prometheus": {
      "model": "zai/glm-5.1",
      "thinking": { "type": "enabled" },
      "fallback_models": ["opencode-go/glm-5.1", "opencode-go/deepseek-v4-pro"]
    },
    "metis": {
      "model": "zai/glm-5.1",
      "thinking": { "type": "enabled" },
      "fallback_models": ["opencode-go/glm-5.1", "opencode-go/deepseek-v4-pro"]
    },
    "momus": {
      "model": "zai/glm-5.1",
      "thinking": { "type": "enabled" },
      "fallback_models": ["opencode-go/glm-5.1", "opencode-go/deepseek-v4-pro"]
    },
    "explore": {
      "model": "zai/glm-4.7",
      "fallback_models": ["opencode-go/deepseek-v4-flash", "opencode-go/qwen3.5-plus"]
    },
    "librarian": {
      "model": "zai/glm-4.7",
      "thinking": { "type": "enabled" },
      "fallback_models": ["opencode-go/deepseek-v4-flash", "opencode-go/qwen3.5-plus"]
    },
    "multimodal-looker": {
      "model": "zai/glm-4.7",
      "fallback_models": ["opencode-go/mimo-v2-omni", "opencode-go/deepseek-v4-flash"]
    },
    "researcher": {
      "model": "zai/glm-4.7",
      "fallback_models": ["opencode-go/deepseek-v4-flash", "opencode-go/qwen3.5-plus"]
    },
    "coder": {
      "model": "zai/glm-4.7",
      "fallback_models": ["opencode-go/deepseek-v4-pro", "opencode-go/kimi-k2.5"]
    },
    "scribe": {
      "model": "zai/glm-4.7",
      "fallback_models": ["opencode-go/deepseek-v4-flash", "opencode-go/qwen3.5-plus"]
    },
    "reviewer": {
      "model": "zai/glm-5.1",
      "thinking": { "type": "enabled" },
      "fallback_models": ["opencode-go/glm-5.1", "opencode-go/deepseek-v4-pro"]
    }
  },

  // ── Categories: cheap tiers use glm-4.5-air ─────────────────────────
  "categories": {
    "writing": {
      "model": "zai/glm-4.5-air",
      "fallback_models": ["opencode-go/deepseek-v4-flash"]
    },
    "quick": {
      "model": "zai/glm-4.5-air",
      "fallback_models": ["opencode-go/deepseek-v4-flash"]
    },
    "unspecified-low": {
      "model": "zai/glm-4.5-air",
      "fallback_models": ["opencode-go/deepseek-v4-flash"]
    },
    "artistry": {
      "model": "zai/glm-4.7",
      "fallback_models": ["opencode-go/deepseek-v4-flash"]
    },
    "deep": {
      "model": "zai/glm-4.7",
      "fallback_models": ["opencode-go/deepseek-v4-pro", "opencode-go/kimi-k2.5"]
    },
    "unspecified-high": {
      "model": "zai/glm-4.7",
      "fallback_models": ["opencode-go/deepseek-v4-pro", "opencode-go/kimi-k2.5"]
    },
    "visual-engineering": {
      "model": "zai/glm-4.7",
      "fallback_models": ["opencode-go/mimo-v2-omni", "opencode-go/deepseek-v4-flash"]
    },
    "ultrabrain": {
      "model": "zai/glm-5.1",
      "thinking": { "type": "enabled" },
      "fallback_models": ["opencode-go/glm-5.1", "opencode-go/deepseek-v4-pro"]
    }
  },

  // ── Runtime fallback: auto-retry on provider errors ──────────────────
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [400, 429, 503, 529],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 60,
    "timeout_seconds": 30,
    "notify_on_fallback": true
  },

  // ── Background tasks concurrency ─────────────────────────────────────
  "background_task": {
    "defaultConcurrency": 5
  },

  // ── Experimental ─────────────────────────────────────────────────────
  "experimental": {
    "aggressive_truncation": false,
    "auto_resume": false
  },

  // ── Hooks ────────────────────────────────────────────────────────────
  "hooks": {
    "thinking_block_validator": { "enabled": true },
    "context_window_monitor": { "enabled": true }
  }
}
