{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "disabled_hooks": [],
  "disabled_agents": [],
  "disabled_skills": [],
  "disabled_mcps": [],
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      400,
      429,
      503,
      529
    ],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 60,
    "timeout_seconds": 30,
    "notify_on_fallback": true
  },
  "background_task": {
    "defaultConcurrency": 5
  },
  "experimental": {
    "aggressive_truncation": false,
    "auto_resume": false
  },
  "hooks": {
    "thinking_block_validator": {
      "enabled": true
    },
    "context_window_monitor": {
      "enabled": true
    }
  },
  "agents": {
    "sisyphus": {
      "model": "zai/glm-4.7",
      "fallback_models": [
        "opencode-go/deepseek-v4-pro",
        "opencode-go/kimi-k2.5"
      ]
    },
    "oracle": {
      "model": "zai/glm-5.1",
      "thinking": {
        "type": "enabled"
      },
      "fallback_models": [
        "opencode-go/glm-5.1",
        "opencode-go/kimi-k2.5"
      ]
    },
    "prometheus": {
      "model": "zai/glm-5.1",
      "thinking": {
        "type": "enabled"
      },
      "fallback_models": [
        "opencode-go/glm-5.1",
        "opencode-go/deepseek-v4-pro"
      ]
    },
    "metis": {
      "model": "zai/glm-4.7",
      "thinking": {
        "type": "enabled"
      },
      "fallback_models": [
        "opencode-go/deepseek-v4-pro",
        "opencode-go/kimi-k2.5"
      ]
    },
    "momus": {
      "model": "zai/glm-5.1",
      "thinking": {
        "type": "enabled"
      },
      "fallback_models": [
        "opencode-go/glm-5.1",
        "opencode-go/deepseek-v4-pro"
      ]
    },
    "explore": {
      "model": "zai/glm-4.7",
      "fallback_models": [
        "opencode-go/deepseek-v4-flash",
        "opencode-go/qwen3.5-plus"
      ]
    },
    "librarian": {
      "model": "zai/glm-4.7",
      "fallback_models": [
        "opencode-go/deepseek-v4-flash",
        "opencode-go/qwen3.5-plus"
      ]
    },
    "multimodal-looker": {
      "model": "opencode-go/mimo-v2-omni",
      "fallback_models": [
        "opencode-go/deepseek-v4-flash"
      ]
    },
    "researcher": {
      "model": "zai/glm-4.7",
      "fallback_models": [
        "opencode-go/deepseek-v4-flash",
        "opencode-go/qwen3.5-plus"
      ]
    },
    "coder": {
      "model": "opencode-go/kimi-k2.5",
      "fallback_models": [
        "opencode-go/deepseek-v4-pro",
        "zai/glm-4.7"
      ]
    },
    "scribe": {
      "model": "opencode-go/qwen3.5-plus",
      "fallback_models": [
        "opencode-go/deepseek-v4-flash"
      ]
    },
    "reviewer": {
      "model": "zai/glm-5.1",
      "thinking": {
        "type": "enabled"
      },
      "fallback_models": [
        "opencode-go/glm-5.1",
        "opencode-go/kimi-k2.5"
      ]
    }
  },
  "categories": {
    "writing": {
      "model": "opencode-go/qwen3.5-plus",
      "fallback_models": [
        "opencode-go/deepseek-v4-flash"
      ]
    },
    "quick": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "unspecified-low": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "artistry": {
      "model": "zai/glm-4.7",
      "fallback_models": [
        "opencode-go/qwen3.5-plus"
      ]
    },
    "deep": {
      "model": "zai/glm-5.1",
      "thinking": {
        "type": "enabled"
      },
      "fallback_models": [
        "opencode-go/deepseek-v4-pro",
        "opencode-go/kimi-k2.5"
      ]
    },
    "unspecified-high": {
      "model": "zai/glm-4.7",
      "fallback_models": [
        "opencode-go/deepseek-v4-pro",
        "opencode-go/kimi-k2.5"
      ]
    },
    "visual-engineering": {
      "model": "opencode-go/mimo-v2-omni",
      "fallback_models": [
        "opencode-go/deepseek-v4-flash"
      ]
    },
    "ultrabrain": {
      "model": "zai/glm-5.1",
      "thinking": {
        "type": "enabled"
      },
      "fallback_models": [
        "opencode-go/glm-5.1",
        "opencode-go/kimi-k2.5"
      ]
    }
  }
}
