{
  // Plugins/hooks a desabilitar se necessário
  "disabled_hooks": [],
  "disabled_agents": [],
  "disabled_skills": [],
  "disabled_mcps": [],
  
  // Agent model overrides (oracle, librarian, sisyphus, etc.)
  "agents": {
    // Primary orchestrators — z.ai models via LiteLLM proxy
    // Tier strategy: glm-5.1 (heavy/thinking) → glm-5-turbo (balanced/flagship-fast) → glm-4.7 (standard 1×) → glm-4.5-air (fast)
    // Peak hours (3× quota): 14:00-18:00 UTC+8 | Off-peak promo 1× until end of June
    "ada-lovelace":        { "model": "zai/glm-5-turbo" },                          // Fast flagship — exploratory analysis
    "alan-turing":         { "model": "zai/glm-5.1",  "thinking": { "type": "enabled" } },
    "grace-hopper":        { "model": "zai/glm-5.1",  "thinking": { "type": "enabled" } },
    "maestro":             { "model": "zai/glm-4.7" },                              // 1× always — legacy orchestrator
    "margaret-hamilton":   { "model": "zai/glm-5.1",  "thinking": { "type": "enabled" } },
    "tony-hoare":          { "model": "zai/glm-5.1",  "thinking": { "type": "enabled" } },  // Fix Engineer — Hoare Logic contracts
    
    // oh-my-openagent agents
    "explore":             { "model": "zai/glm-4.7" },                              // 1× always — high-volume grep
    "librarian":           { "model": "zai/glm-4.7",  "thinking": { "type": "enabled" } },
    "metis":               { "model": "zai/glm-5.1",  "thinking": { "type": "enabled" } },
    "momus":               { "model": "zai/glm-5.1",  "thinking": { "type": "enabled" } },
    "multimodal":          { "model": "zai/glm-5-turbo" },                          // Fast flagship with vision
    "oracle":              { "model": "zai/glm-5.1",  "thinking": { "type": "enabled" } },
    "prometheus":          { "model": "zai/glm-5.1",  "thinking": { "type": "enabled" } },
    "sisyphus":            { "model": "zai/glm-5-turbo" },                          // Fast flagship — main session agent
    
    // opencode-workspace agents
    "researcher":          { "model": "zai/glm-4.7" },                              // 1× always — fast search
    "coder":               { "model": "zai/glm-5-turbo" },                          // Fast flagship — implementation
    "scribe":              { "model": "zai/glm-4.7" },                              // 1× always — docs
    "reviewer":            { "model": "zai/glm-5.1",  "thinking": { "type": "enabled" } },  // Deep review
    

  },
  // Category model overrides — z.ai models via LiteLLM proxy
  "categories": {
    "writing":             { "model": "zai/glm-4.7" },                              // 1× always
    "quick":               { "model": "zai/glm-4.7" },                              // 1× always
    "deep":                { "model": "zai/glm-5-turbo" },                          // Fast flagship
    "unspecified-low":     { "model": "zai/glm-4.7" },                              // 1× always
    "unspecified-high":    { "model": "zai/glm-5-turbo" },                          // Fast flagship
    "visual-engineering":  { "model": "zai/glm-5-turbo" },                          // Fast flagship (vision)
    "ultrabrain":          { "model": "zai/glm-5.1",  "thinking": { "type": "enabled" } },
    "artistry":            { "model": "zai/glm-5-turbo" }                           // Fast flagship
  },
  
  // Features experimentais
  "experimental": {
    "aggressive_truncation": true,  // was false — more aggressive context pruning saves tokens but may lose old context
    "auto_resume": false
  },
  
  // Hooks específicos
  "hooks": {
    "thinking_block_validator": { "enabled": true },
    "context_window_monitor": { "enabled": true }
  }
}