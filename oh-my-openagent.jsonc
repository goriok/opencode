{
  // Plugins/hooks a desabilitar se necessário
  "disabled_hooks": [],
  "disabled_agents": [],
  "disabled_skills": [],
  "disabled_mcps": [],
  
  // Agent model overrides (oracle, librarian, sisyphus, etc.)
  "agents": {
    // Primary orchestrators
    "ada-lovelace":        { "model": "opencode-go/deepseek-v4-flash" },
    "alan-turing":         { "model": "opencode-go/deepseek-v4-pro",  "thinking": { "type": "enabled" } },
    "grace-hopper":        { "model": "opencode-go/deepseek-v4-pro",  "thinking": { "type": "enabled" } },
    "maestro":             { "model": "opencode-go/glm-5.1" },
    "margaret-hamilton":   { "model": "opencode-go/deepseek-v4-pro", "thinking": { "type": "enabled" } },
    
    // oh-my-openagent agents
    "explore":             { "model": "opencode-go/qwen3.5-plus" },                  // P6: max volume exploration (50.5K req/mo)
    "librarian":           { "model": "opencode-go/deepseek-v4-flash", "thinking": { "type": "enabled" } },
    "metis":               { "model": "opencode-go/deepseek-v4-pro",  "thinking": { "type": "enabled" } },
    "momus":               { "model": "opencode-go/deepseek-v4-pro",  "thinking": { "type": "enabled" } },
    "multimodal":          { "model": "opencode-go/mimo-v2-omni" },
    "oracle":              { "model": "opencode-go/deepseek-v4-pro", "thinking": { "type": "enabled" } },
    "prometheus":          { "model": "opencode-go/deepseek-v4-pro", "thinking": { "type": "enabled" } },
    "sisyphus":            { "model": "opencode-go/kimi-k2.5" },                    // P6: was glm-5.1 — 2.1x more volume (9.2K req/mo)
    
    // opencode-workspace agents (P1 fix — previously defaulted to claude-*)
    "researcher":          { "model": "opencode-go/deepseek-v4-flash" },           // was claude-haiku (fast search)
    "coder":               { "model": "opencode-go/deepseek-v4-pro" },             // was claude-sonnet (balanced impl)
    "scribe":              { "model": "opencode-go/deepseek-v4-flash" },           // was claude-haiku (docs)
    "reviewer":            { "model": "opencode-go/deepseek-v4-pro", "thinking": { "type": "enabled" } },  // was claude-opus (deep review)
    

  },
  // Category model overrides (forces all categories to use opencode-go)
  "categories": {
    "writing":             { "model": "opencode-go/deepseek-v4-flash" },
    "quick":               { "model": "opencode-go/deepseek-v4-flash" },
    "deep":                { "model": "opencode-go/deepseek-v4-pro" },
    "unspecified-low":     { "model": "opencode-go/deepseek-v4-flash" },
    "unspecified-high":    { "model": "opencode-go/glm-5.1" },
    "visual-engineering":  { "model": "opencode-go/glm-5.1" },
    "ultrabrain":          { "model": "opencode-go/deepseek-v4-pro", "thinking": { "type": "enabled" } },
    "artistry":            { "model": "opencode-go/glm-5.1" }
  },
  
  // Features experimentais
  "experimental": {
    "aggressive_truncation": true,  // was false — more aggressive context pruning saves tokens but may lose old context
    "auto_resume": false
  },
  
  // Hooks específicos
  "hooks": {
    "thinking_block_validator": { "enabled": true },
    "context_window_monitor": { "enabled": true }
  }
}