{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "disabled_hooks": [],
  "disabled_agents": [],
  "disabled_skills": [],
  "disabled_mcps": [],
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [
      400,
      429,
      503,
      529
    ],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 60,
    "timeout_seconds": 30,
    "notify_on_fallback": true
  },
  "background_task": {
    "defaultConcurrency": 5
  },
  "experimental": {
    "aggressive_truncation": false,
    "auto_resume": false
  },
  "hooks": {
    "thinking_block_validator": {
      "enabled": true
    },
    "context_window_monitor": {
      "enabled": true
    }
  },
  "agents": {
    // Planning layer — highest capability models
    "prometheus": {
      "model": "github-copilot/claude-opus-4-7",
      "variant": "max",
      "fallback_models": [
        "github-copilot/gpt-5.5"
      ]
    },
    "metis": {
      "model": "github-copilot/claude-sonnet-4-6",
      "fallback_models": [
        "github-copilot/claude-opus-4-7"
      ]
    },
    "momus": {
      "model": "github-copilot/gpt-5.5",
      "fallback_models": [
        "github-copilot/claude-opus-4-7"
      ]
    },
    // Primary agents
    "sisyphus": {
      "model": "github-copilot/claude-opus-4-7",
      "variant": "max",
      "fallback_models": [
        "github-copilot/gpt-5.5"
      ]
    },
    // Subagents — specialized workers
    "oracle": {
      "model": "github-copilot/gpt-5.5",
      "fallback_models": [
        "github-copilot/gemini-3.1-pro",
        "github-copilot/claude-opus-4-7"
      ]
    },
    "sisyphus-junior": {
      "model": "github-copilot/claude-sonnet-4-6",
      "fallback_models": [
        "github-copilot/gpt-5.5"
      ]
    }
  },
  "categories": {
    "writing": {
      "model": "github-copilot/claude-sonnet-4-6",
      "fallback_models": [
        "github-copilot/gemini-3.1-pro"
      ]
    },
    "quick": {
      "model": "github-copilot/gpt-5.4-mini",
      "fallback_models": [
        "github-copilot/claude-haiku-4-5"
      ]
    },
    "unspecified-low": {
      "model": "github-copilot/claude-sonnet-4-6"
    },
    "artistry": {
      "model": "github-copilot/gemini-3.1-pro",
      "fallback_models": [
        "github-copilot/claude-opus-4-7"
      ]
    },
    "deep": {
      "model": "github-copilot/gpt-5.5",
      "fallback_models": [
        "github-copilot/claude-opus-4-7",
        "github-copilot/gemini-3.1-pro"
      ]
    },
    "unspecified-high": {
      "model": "github-copilot/claude-opus-4-7",
      "variant": "max",
      "fallback_models": [
        "github-copilot/gpt-5.5"
      ]
    },
    "visual-engineering": {
      "model": "github-copilot/gemini-3.1-pro",
      "fallback_models": [
        "github-copilot/claude-opus-4-7"
      ]
    },
    "ultrabrain": {
      "model": "github-copilot/gpt-5.5",
      "fallback_models": [
        "github-copilot/gemini-3.1-pro",
        "github-copilot/claude-opus-4-7"
      ]
    }
  }
}
