{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "mcp": {
    // opencode-mem plugin gerencia memória via MCP próprio
    // Este MCP memory é desabilitado para evitar duplicação
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": false
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "opencode-mem",
    "oh-my-opencode",
    "opencode-workspace",
    "micode"
  ]
}
