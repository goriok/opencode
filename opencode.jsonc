{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "mcp": {
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "gitlab": {
      "type": "local",
      "command": [
        "npx", 
        "-y", 
        "@zereight/mcp-gitlab@latest",
        "--token=donotsavemephVwc_vt41oEYaQrsd7w",
        "--api-url=https://gitlab.luizalabs.com/api/v4"
      ],
      "environment": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0",
        "NODE_OPTIONS": "--no-warnings"
      },
      "enabled": true,
      "timeout": 30000
    }
  }
}
