{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "experimental": {
    "mcp_lazy": true,
    "cache_stabilization": true,
    "cache_1h_ttl": true
  },
  "provider": {
    "litellm-opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM Opencode Go",
      "options": {
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "{env:LITELLM_OPENCODE_GO_API_KEY}"
      },
      "models": {
        "opencode-go/deepseek-v4-pro":   { "name": "DeepSeek V4 Pro" },
        "opencode-go/deepseek-v4-flash": { "name": "DeepSeek V4 Flash" },
        "opencode-go/glm-5.1":           { "name": "GLM 5.1" },
        "opencode-go/kimi-k2.5":         { "name": "Kimi K2.5" },
        "opencode-go/qwen3.5-plus":      { "name": "Qwen3.5 Plus" },
        "opencode-go/mimo-v2-omni":      { "name": "MiMo V2 Omni" }
      }
    },
    "litellm-zai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM Z.AI",
      "options": {
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "{env:LITELLM_ZAI_API_KEY}"
      },
      "models": {
        "zai/glm-5.1":     { "name": "GLM 5.1 (z.ai)" },
        "zai/glm-4.7":     { "name": "GLM 4.7 (z.ai)" },
        "zai/glm-4.5-air": { "name": "GLM 4.5 Air (z.ai)" }
      }
    },
    "litellm-deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM Deepseek",
      "options": {
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "{env:LITELLM_DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-v4-pro":   { "name": "DeepSeek V4 Pro" },
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash" }
      }
    }
  },
  "mcp": {
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "recall": {
      "type": "local",
      "command": ["recall-mcp"],
      "enabled": true
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "opencode-mem",
    "oh-my-openagent",
    "opencode-workspace"
  ]
}
