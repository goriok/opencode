# LiteLLM Proxy — variáveis de ambiente
# Copie para .env e preencha. O .env NÃO é versionado (.gitignore).
#
# Setup rápido:
#   bash ~/.config/opencode/litellm/setup-litellm.sh

# ─── Chave mestra do proxy ────────────────────────────────────────────────────
# Usada para autenticar no UI (localhost:4000/ui) e gerar virtual keys.
# Pode ser qualquer string — troque em produção.
LITELLM_MASTER_KEY=sk-litellm-local

# ─── Anthropic ────────────────────────────────────────────────────────────────
# DEIXE VAZIO — Claude Code usa OAuth (Claude Max subscription).
# O token OAuth é repassado automaticamente via forward_client_headers_to_llm_api.
# Preencher aqui causaria conflito de autenticação e erros 429.
ANTHROPIC_API_KEY=

# ─── opencode-go ─────────────────────────────────────────────────────────────
# Obtenha em: https://opencode.ai/auth → campo "API Key"
OPENCODE_GO_API_KEY=

# ─── z.ai / GLM Coding Plan ────────────────────────────────────────────────────
# Obtenha em: https://z.ai/manage-apikey/apikey-list
# Usa o endpoint de Coding Plan (não o endpoint geral /api/paas/v4).
# O provider nativo litellm zai/ roteia pro endpoint errado — por isso usamos
# openai/ prefix + api_base manual no config.yaml.
# Ref: https://github.com/BerriAI/litellm/issues/25479
ZAI_API_KEY=
